{
  "manifest_version": 3,
  "name": "Gerador de Payload AJO — WhatsApp (MRV)",
  "version": "1.0.0",
  "description": "Gera payloads formatados para Custom Actions no Adobe Journey Optimizer (WhatsApp/Infobip).",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "host_permissions": ["*://*.infobip.com/*", "*://*.ibintegrations.com/*"],
  "action": { "default_title": "Abrir Gerador de Payload AJO" },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
